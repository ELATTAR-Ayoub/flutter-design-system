# The origin the documentation site and the registry are served from.
#
# ONE value, and everything that needs the host derives from it: the CLI's
# `defaultRegistryUrl`, the site build's `--dart-define`, the Vercel deploy,
# and CI. Moving the site is this line, not a grep across four file types.
#
# Copy this file to `.env` and edit it. `.env` is gitignored; this file is
# committed and is the documentation.
#
# Note what this file CANNOT do: it cannot change what a stranger gets. A
# published CLI is compiled on the user's machine by `dart pub global
# activate`, with no access to anything here, so the shipped default lives in
# `packages/elattar_cli/lib/src/identity.dart` and this variable overrides it
# only at compile time (`--define`) or run time (ELATTAR_REGISTRY_URL).
ELATTAR_SITE_ORIGIN=https://flutter.elattar.dev

# What the Flutter web build is served under. `/` for a domain of its own,
# `/flutter-design-system/` for a GitHub Pages project subpath. A wrong value
# here is a white screen, not an error: the app boots and every asset 404s.
ELATTAR_SITE_BASE_HREF=/

# Points one shell, or one CI job, at a different registry — a staging host, a
# fork, or a local `registry/generated/latest`. Overrides the compiled default
# and `elattar.yaml`, and is itself overridden by `--registry`. Left unset in
# normal use.
# ELATTAR_REGISTRY_URL=

# Where the CLI keeps its downloaded registry payloads. Unset means the
# platform cache directory.
# ELATTAR_CACHE_DIR=
