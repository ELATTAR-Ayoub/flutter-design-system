# Vercel uploads the working tree before it builds. Everything here is either
# rebuilt during the build or is not part of the site.

# 29 MB of Puppeteer and its bundled Chrome download, for the parity capture
# rig. Never needed to build the site.
tool/verify/node_modules/
tool/verify/out/

# Build outputs and package caches, all regenerated by the build itself.
**/.dart_tool/
**/build/
.flutter/
.pub-cache/

# Local environment. `.env.example` is what the build reads when nothing is
# set — see `tool/deploy_site/lib/build_site.dart`.
.env

# Development history and process records. Large, and not served.
docs/superpowers/
.claude/
